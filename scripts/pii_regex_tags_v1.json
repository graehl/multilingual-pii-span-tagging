{
  "schema": "pii-regex-tag/v1",
  "default_ontology": "ont3",
  "description": "Structured-identifier regexes applied after the classifier. Group 1 of each pattern is the tagged span so a cue can sit outside it; every rule is measured in research/pii/frontier/evidence and was tightened on 2026-09-11 from 35% to 99% precision over 13,151 completely annotated rows. `tags` gives the label per ontology: ont3 uses the successor type, the production toolkit keeps the pack's own class name.",
  "source": {
    "pack": "the production language pack's configuration",
    "module": "privacy-filter",
    "note": "patterns copied verbatim; keep in step with the pack"
  },
  "rules": [
    {
      "class": "URL",
      "regex": "(https?://(?:www\\.)?[-a-zA-Z0-9@:%._+~#=]{1,256}\\.[a-zA-Z0-9()]{1,63}\\b[-a-zA-Z0-9()@:%_+.~#?&/=]*?)(?=[.?,]*(?:\\s|$)|[^-a-zA-Z0-9()@:%_+.~#?&/=])",
      "tags": {
        "ont3": "url",
        "ont2": "url",
        "the production toolkit": "URL"
      },
      "fine": "URL"
    },
    {
      "class": "EMAIL",
      "regex": "(?:^|[^A-Za-z0-9._%+\\-])([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,63})\\b",
      "tags": {
        "ont3": "email",
        "ont2": "email",
        "the production toolkit": "EMAIL"
      },
      "fine": "EMAIL"
    },
    {
      "class": "IPV4",
      "regex": "(?:^|[^\\w\\/.])((?:(?:25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]?\\d))(?![\\w.])",
      "tags": {
        "ont3": "ip_address",
        "ont2": "ip_address",
        "the production toolkit": "IPV4"
      },
      "fine": "IPV4"
    },
    {
      "class": "IPV6",
      "regex": "\\b((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:(?:[0-9A-Fa-f]{1,4})?)",
      "tags": {
        "ont3": "ip_address",
        "ont2": "ip_address",
        "the production toolkit": "IPV6"
      },
      "fine": "IPV6"
    },
    {
      "class": "IBAN",
      "regex": "\\b([A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]{4}){3,7}(?:[ ]?[A-Z0-9]{1,3})?)\\b",
      "tags": {
        "ont3": "bank_account_number",
        "ont2": "bank_account_number",
        "the production toolkit": "IBAN"
      },
      "fine": "IBAN"
    },
    {
      "class": "MAC_ADDRESS",
      "regex": "\\b((?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}|(?:[0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2})\\b",
      "tags": {
        "ont3": "device_identifier",
        "ont2": "device_identifier",
        "the production toolkit": "MAC_ADDRESS"
      },
      "fine": "MAC_ADDRESS"
    },
    {
      "class": "CREDIT_CARD",
      "regex": "\\b((?:4\\d{3}|5[1-5]\\d{2}|2(?:22[1-9]|2[3-9]\\d|[3-6]\\d{2}|7[01]\\d|720)|6(?:011|5\\d{2}))[ -]?\\d{4}[ -]?\\d{4}[ -]?\\d{4})\\b",
      "tags": {
        "ont3": "payment_card_data",
        "ont2": "payment_card_data",
        "the production toolkit": "CREDIT_CARD"
      },
      "fine": "CREDIT_CARD"
    },
    {
      "class": "US-MBI",
      "regex": "\\b([0-9][ACDEFGHJKMNPQRTUVWXY][0-9ACDEFGHJKMNPQRTUVWXY][0-9]-[ACDEFGHJKMNPQRTUVWXY][0-9ACDEFGHJKMNPQRTUVWXY][0-9]-[ACDEFGHJKMNPQRTUVWXY][ACDEFGHJKMNPQRTUVWXY][0-9][0-9])\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "US-MBI"
      },
      "fine": "US-MBI"
    },
    {
      "class": "US-DEA_MEDICAL_CERTIF_NUMBER",
      "regex": "(?:^|[^\\w\\/])([ABCDEFGHJKLMPRSTUX][A-Z]\\d{7})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "US-DEA_MEDICAL_CERTIF_NUMBER"
      },
      "fine": "US-DEA_MEDICAL_CERTIF_NUMBER"
    },
    {
      "class": "US-SSN",
      "regex": "\\b((?!000|666|9\\d\\d)\\d{3}[- ](?!00)\\d{2}[- ](?!0000)\\d{4})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "US-SSN"
      },
      "fine": "US-SSN"
    },
    {
      "class": "US-PASSPORT",
      "regex": "(?:^|[^\\w\\/])([A-Z]\\d{8})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "US-PASSPORT"
      },
      "fine": "US-PASSPORT"
    },
    {
      "class": "US-ITIN",
      "regex": "\\b(9\\d{2}-(?:5\\d|6[0-5]|7\\d|8[0-8]|9(?:[0-2]|[4-9]))-\\d{4})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "US-ITIN"
      },
      "fine": "US-ITIN"
    },
    {
      "class": "US-ZIPCODE",
      "regex": "(?:,\\s?[A-Z]{2}\\s)(\\d{5}(?:-\\d{4})?)\\b",
      "tags": {
        "ont3": "postal_code",
        "ont2": "postal_code",
        "the production toolkit": "US-ZIPCODE"
      },
      "fine": "US-ZIPCODE"
    },
    {
      "class": "US-ROUTING_TRANSIT_NUMBER",
      "regex": "(?:[Rr]outing|ABA|RTN)[^0-9]{0,12}((?:0[1-9]|1[0-2]|2[1-9]|3[0-2]|6[1-9]|7[0-2]|80)\\d{7})\\b",
      "tags": {
        "ont3": "bank_routing_code",
        "ont2": "bank_routing_code",
        "the production toolkit": "US-ROUTING_TRANSIT_NUMBER"
      },
      "fine": "US-ROUTING_TRANSIT_NUMBER"
    },
    {
      "class": "US-BANK",
      "regex": "(?:[Aa]ccount|[Aa]cct|IBAN)\\.?\\s*(?:[Nn]o\\.?|[Nn]umber|#)?\\s*[:#]?\\s*(\\d{8,17})\\b",
      "tags": {
        "ont3": "bank_account_number",
        "ont2": "bank_account_number",
        "the production toolkit": "US-BANK"
      },
      "fine": "US-BANK"
    },
    {
      "class": "US-NPI",
      "regex": "\\b([12]\\d{3}[ -]\\d{3}[ -]\\d{3})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "US-NPI"
      },
      "fine": "US-NPI"
    },
    {
      "class": "UK-DRIVER_LICENSE_NUMBER",
      "regex": "\\b([A-Z9]{5}\\d(?:0[1-9]|1[0-2]|5[1-9]|6[0-2])(?:0[1-9]|[12]\\d|3[01])\\d[A-Z9]{2}[A-Z0-9][A-Z]{2})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "UK-DRIVER_LICENSE_NUMBER"
      },
      "fine": "UK-DRIVER_LICENSE_NUMBER"
    },
    {
      "class": "UK-PASSPORT",
      "regex": "(?:^|[^\\w\\/])([A-Z]{2}\\d{7})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "UK-PASSPORT"
      },
      "fine": "UK-PASSPORT"
    },
    {
      "class": "UK-POSTCODE",
      "regex": "\\b((?:GIR\\s?0AA|[A-PR-UWYZ](?:[0-9][ABCDEFGHJKPSTUW]?|[0-9]{2}|[A-HK-Y][0-9][ABEHMNPRVWXY]?|[A-HK-Y][0-9]{2})\\s?[0-9][ABD-HJLNP-UW-Z]{2}))\\b",
      "tags": {
        "ont3": "postal_code",
        "ont2": "postal_code",
        "the production toolkit": "UK-POSTCODE"
      },
      "fine": "UK-POSTCODE"
    },
    {
      "class": "UK-VEHICLE_REGISTRATION",
      "regex": "\\b([A-HJ-PR-Y]{2}(?:0[1-9]|[1-7][0-9])[- ]?[A-HJ-PR-Z]{3})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "UK-VEHICLE_REGISTRATION"
      },
      "fine": "UK-VEHICLE_REGISTRATION"
    },
    {
      "class": "UK-NHS",
      "regex": "NHS[^0-9]{0,12}(\\d{3}\\s?\\d{3}\\s?\\d{4})\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "UK-NHS"
      },
      "fine": "UK-NHS"
    },
    {
      "class": "UK-NI_NUMBER",
      "regex": "\\b((?!BG|GB|NK|KN|NT|TN|ZZ)[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z]\\s?\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?[A-D])\\b",
      "tags": {
        "ont3": "government_id",
        "ont2": "government_id",
        "the production toolkit": "UK-NI_NUMBER"
      },
      "fine": "UK-NI_NUMBER"
    }
  ],
  "families": {
    "admin_area": "location",
    "age": "attribute",
    "bank_account_number": "financial",
    "bank_routing_code": "financial",
    "credential": "credential",
    "date": "date_time",
    "date_of_birth": "date_time",
    "demographic_attribute": "attribute",
    "device_identifier": "digital",
    "email": "contact",
    "government_id": "authority_id",
    "gps_coordinates": "location",
    "health_condition": "attribute",
    "ip_address": "digital",
    "locality": "location",
    "location": "location",
    "monetary_amount": "financial",
    "organization": "organization",
    "payment_card_data": "financial",
    "person_name": "person",
    "phone_number": "contact",
    "postal_code": "location",
    "protected_attribute": "attribute",
    "quantity": "other",
    "record_identifier": "org_id",
    "street_address": "location",
    "time": "date_time",
    "url": "contact",
    "username": "digital"
  },
  "policy_note": "Arbitration lives in scripts/pii_regex_policy_ont3_v1.json, because it depends on the trained model rather than on the ontology. Without one the model keeps any span it already found."
}
