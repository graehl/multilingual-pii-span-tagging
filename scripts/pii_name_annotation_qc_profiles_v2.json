{
  "schema": "pii-name-annotation-qc-profiles",
  "version": 2,
  "annotation_contract": {
    "carrier_labels": [
      "person_name",
      "given_name",
      "middle_name",
      "family_name",
      "name_prefix",
      "clinician_name",
      "patient_name",
      "relative_name"
    ],
    "component_labels": {
      "given_name": "given_name",
      "middle_name": "middle_name",
      "family_name": "family_name"
    },
    "suppress_name_when_exactly_relabeled_as": [
      "organization_reference",
      "person_reference"
    ],
    "projection_values": {
      "P19": [
        "person_name"
      ],
      "P20": [
        "person_name"
      ],
      "family": [
        "person",
        "person_name"
      ]
    }
  },
  "defaults": {
    "grammar": "und",
    "limits": {
      "max_join_gap_chars": 4,
      "max_name_atoms": 8
    },
    "scoring": {
      "minimum_assignment_margin": 1.0,
      "weights": {
        "order": 1.5,
        "comma": 8.0,
        "source_component": 0.0,
        "lexicon": 3.0,
        "compact_default": 1.25
      }
    },
    "lexicons": {
      "family_particles": [
        "al",
        "ap",
        "bin",
        "binti",
        "da",
        "de",
        "del",
        "della",
        "der",
        "di",
        "dos",
        "du",
        "la",
        "le",
        "van",
        "von",
        "zu"
      ],
      "honorifics": [
        "dr",
        "miss",
        "mr",
        "mrs",
        "ms",
        "prof",
        "sir"
      ],
      "given_files": [],
      "family_files": []
    }
  },
  "grammars": {
    "und": {
      "component_order": "any",
      "allow_comma_inversion": true,
      "compact_name": null
    },
    "given_first": {
      "component_order": "given_first",
      "allow_comma_inversion": true,
      "compact_name": null
    },
    "family_first": {
      "component_order": "family_first",
      "allow_comma_inversion": true,
      "compact_name": null
    },
    "zh_han": {
      "component_order": "family_first",
      "allow_comma_inversion": true,
      "compact_name": {
        "script": "Han",
        "family_lengths": [
          1,
          2
        ],
        "default_family_length": 1
      }
    },
    "ko_hangul": {
      "component_order": "family_first",
      "allow_comma_inversion": true,
      "compact_name": {
        "script": "Hangul",
        "family_lengths": [
          1,
          2
        ],
        "default_family_length": 1
      }
    }
  },
