  ],
  "name_kind_model": {
    "config_path": "name-kind.config.json",
    "candidate_scope": "component subspans permitted by the selected language grammar",
    "role_components": {
      "given": "given_name",
      "family": "family_name"
    },
    "score_transform": "centered_log_odds",
    "score_weight": 0.4
  },
  "symbols": {
    "given_name": "G",
    "middle_name": "M",
    "family_name": "F"
  },
  "ignored_values": [
    "Q"
  ],
  "sequence_pattern": "(?:G|M|F|GM?F|FGM?)",
  "sequence_pattern_semantics": "Name atomization is character-based, not tokenizer-based: atoms are Unicode letter/mark runs with configured internal joiners. Whitespace and non-joiner punctuation have no component value; a multi-atom component span may include the separators between its first and last atom. Q is an explicit ignored component value, currently used for honorific atoms, not a background label for separators. Compact names split one atom at Unicode-codepoint offsets. Collapse consecutive component decisions into exact component spans, remove Q components, map the remaining values through symbols, and require a full regular-expression match. The pattern describes every component sequence generated by the postprocessor; partition_policy declares which candidate character partitions are considered.",
  "annotation_contract": {
    "carrier_labels": [
      "person_name",
      "given_name",
      "middle_name",
      "family_name",
      "name_prefix",
      "clinician_name",
      "patient_name",
      "relative_name"
    ],
    "component_labels": {
      "given_name": "given_name",
      "middle_name": "middle_name",
      "family_name": "family_name"
    },
    "suppress_name_when_exactly_relabeled_as": [
      "organization_reference",
      "person_reference"
    ],
    "projection_values": {
      "P19": [
        "person_name"
      ],
      "P20": [
        "person_name"
      ],
      "family": [
        "person",
        "person_name"
      ]
    }
  },
