{
 "schema": "pii-needle-set/v1",
 "purpose": "Select crawl paragraphs likely to contain rare identifier, financial and technical PII types (gaps/rare-type-native-coverage.md). Weight 3 marks a checksum-validated or cue-anchored value that alone meets the default threshold; weaker signals must combine.",
 "needles": [
  {"name": "iban", "type": "bank_account_number", "weight": 3, "validator": "iban",
   "pattern": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,4})?\\b"},
  {"name": "payment_card", "type": "payment_card_data", "weight": 3, "validator": "payment_card",
   "pattern": "(?<![\\d-])(?:\\d[ -]?){12,18}\\d(?![\\d-])"},
  {"name": "imei", "type": "device_identifier", "weight": 3, "validator": "imei",
   "pattern": "(?<![A-Za-z0-9/-])\\d{15}(?![A-Za-z0-9/-])", "cues": {"*": ["imei"]}},
  {"name": "mac_address", "type": "device_identifier", "weight": 2,
   "pattern": "\\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\b"},
  {"name": "ipv4", "type": "ip_address", "weight": 2, "validator": "ipv4",
   "pattern": "(?<![\\d.])(?:\\d{1,3}\\.){3}\\d{1,3}(?![\\d.])"},
  {"name": "ipv6", "type": "ip_address", "weight": 2, "validator": "ipv6",
   "pattern": "(?<![\\w:])(?:[0-9A-Fa-f]{1,4}:){3,7}[0-9A-Fa-f]{1,4}(?![\\w:])"},
  {"name": "gps_decimal", "type": "gps_coordinates", "weight": 2, "validator": "latitude_longitude",
   "pattern": "[-+]?\\d{1,2}\\.\\d{4,}\\s*[,;]\\s*[-+]?\\d{1,3}\\.\\d{4,}"},
  {"name": "gps_dms", "type": "gps_coordinates", "weight": 1.5,
   "pattern": "\\d{1,3}°\\s?\\d{1,2}[′']\\s?(?:\\d{1,2}(?:[.,]\\d+)?[″\"]\\s?)?[NSEWnsew]"},
  {"name": "pesel", "type": "government_id", "weight": 3, "validator": "pesel", "languages": ["pl"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{11}(?![A-Za-z0-9/-])"},
  {"name": "rodne_cislo", "type": "government_id", "weight": 3, "validator": "rodne_cislo", "languages": ["cs"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{6}/?\\d{4}(?![A-Za-z0-9/-])"},
  {"name": "tckn", "type": "government_id", "weight": 3, "validator": "tckn", "languages": ["tr"],
   "pattern": "(?<![A-Za-z0-9/-])[1-9]\\d{10}(?![A-Za-z0-9/-])"},
  {"name": "aadhaar", "type": "government_id", "weight": 3, "validator": "aadhaar", "languages": ["hi", "bn", "ta", "te", "ur"],
   "pattern": "(?<![A-Za-z0-9/-])[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?![A-Za-z0-9/-])"},
  {"name": "korean_rrn", "type": "government_id", "weight": 3, "validator": "korean_rrn", "languages": ["ko"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{6}-[1-4]\\d{6}(?![A-Za-z0-9/-])"},
  {"name": "chinese_resident_id", "type": "government_id", "weight": 3, "validator": "chinese_resident_id", "languages": ["zh"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{17}[\\dXx](?![A-Za-z0-9/-])"},
  {"name": "israeli_id", "type": "government_id", "weight": 3, "validator": "israeli_id", "languages": ["he"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{9}(?![A-Za-z0-9/-])", "cues": {"he": ["ת.ז", "ת\"ז", "תעודת זהות", "מספר זהות"]}},
  {"name": "snils", "type": "government_id", "weight": 3, "validator": "snils", "languages": ["ru"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{3}-\\d{3}-\\d{3}[ -]\\d{2}(?![A-Za-z0-9/-])"},
  {"name": "finnish_hetu", "type": "government_id", "weight": 2, "languages": ["fi"],
   "pattern": "\\b\\d{6}[-+A]\\d{3}[0-9A-Y]\\b"},
  {"name": "indonesian_nik", "type": "government_id", "weight": 2, "languages": ["id"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{16}(?![A-Za-z0-9/-])", "cues": {"id": ["nik", "nomor induk kependudukan", "ktp"]}},
  {"name": "ukrainian_rnokpp", "type": "government_id", "weight": 2, "languages": ["uk"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{10}(?![A-Za-z0-9/-])", "cues": {"uk": ["рнокпп", "іпн", "ідентифікаційний код", "податковий номер"]}},
  {"name": "russian_inn", "type": "government_id", "weight": 2, "languages": ["ru"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{12}(?![A-Za-z0-9/-])", "cues": {"ru": ["инн"]}},
  {"name": "japanese_my_number", "type": "government_id", "weight": 2, "languages": ["ja"],
   "pattern": "(?<![A-Za-z0-9/-])\\d{4}\\s?\\d{4}\\s?\\d{4}(?![A-Za-z0-9/-])", "cues": {"ja": ["マイナンバー", "個人番号"]}},
  {"name": "credential_cue", "type": "credential", "weight": 3, "ignore_case": true,
   "pattern": "(?:password|passwd|pwd|heslo|hasło|haslo|пароль|парол|비밀번호|パスワード|密码|密碼|şifre|sifre|salasana|סיסמה|كلمة المرور|كلمة السر|kata sandi|পাসওয়ার্ড|கடவுச்சொல்)\\s*[:：=]\\s*\\S{4,40}"},
  {"name": "date_of_birth_cue", "type": "date_of_birth", "weight": 3, "ignore_case": true,
   "pattern": "(?:date of birth|d\\.o\\.b\\.?|datum narození|narozen[aá]?|data urodzenia|urodzon[ya]|дата рождения|дата народження|생년월일|生年月日|出生日期|doğum tarihi|syntymäaika|תאריך לידה|تاريخ الميلاد|tanggal lahir|জন্ম ?তারিখ|பிறந்த தேதி)\\s*[:：]?\\s*(?:\\d{1,4}[./\\-]\\d{1,2}[./\\-]\\d{1,4}|\\d{4}\\s?[年년]\\s?\\d{1,2}\\s?[月월]\\s?\\d{1,2}\\s?[日일]|\\d{1,2}\\.?\\s\\S{3,12}\\s\\d{4})"},
  {"name": "japanese_postal", "type": "postal_code", "weight": 1.5, "languages": ["ja"],
   "pattern": "〒\\s?\\d{3}-\\d{4}"},
  {"name": "postal_cue", "type": "postal_code", "weight": 1.5, "ignore_case": true,
   "pattern": "(?:PSČ|kod pocztowy|почтовый индекс|поштовий індекс|우편번호|posta kodu|postinumero|מיקוד|الرمز البريدي|kode pos|邮编|郵便番号)\\s*[:：]?\\s*\\d{2,6}(?:[ -]\\d{2,4})?"},
  {"name": "phone_international", "type": "phone_number", "weight": 1,
   "pattern": "(?<![\\w+])\\+\\d{1,3}[\\s-]?\\(?\\d{1,4}\\)?(?:[\\s-]?\\d{2,4}){2,4}(?!\\d)"},
  {"name": "email", "type": "email", "weight": 1,
   "pattern": "[\\w.+-]+@[\\w-]+\\.[\\w.-]+"}
 ]
}
